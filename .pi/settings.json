{
  "$schema": "https://pi.dev/schema/settings.json",
  "comment": "Project-local Pi settings matching Emil Prive's setup (see IMG_1156). Global Ollama provider is declared in ~/.pi/agent/models.json by the install scripts.",
  "defaultProvider": "ollama",
  "defaultModel": "ollama/kimi-k2.7-code",
  "defaultThinkingLevel": "medium",
  "theme": "dark",
  "quietStartup": false,
  "defaultProjectTrust": "ask",
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "baseDelayMs": 2000,
    "provider": {
      "timeoutMs": 3600000,
      "maxRetries": 0,
      "maxRetryDelayMs": 60000
    }
  },
  "terminal": {
    "showImages": true,
    "imageWidthCells": 60
  },
  "packages": [
    "npm:@plannotator/pi-extension",
    "npm:@ff-labs/pi-fff",
    "npm:pi-web-extension",
    "npm:pi-cursor-sdk",
    "npm:pi-thinking-steps",
    "npm:pi-mcp-adapter",
    "npm:@sampfp/pi-essentials"
  ]
}
